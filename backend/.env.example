# Process mode, HTTP port, and local listener.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Private storage. A blank DATABASE_PATH resolves to DATA_DIR/app.sqlite.
DATA_DIR=./data
DATABASE_PATH=

# Config profiles are fixture, authorized-direct, or licensed-feed.
# Stage 1 validates grants locally. Exchange requests begin in Stage 2.
DATA_MODE=fixture
LIVE_POLLING_ENABLED=false
LIVE_MAX_DOCUMENTS_PER_POLL=0
# Bootstrap the synthetic fixture pipeline automatically. The replay CLI queues extra events.
FIXTURE_WATCH_ENABLED=true

# Set only with permission and an approved HTTPS feed URL for each exchange.
NSE_ACCESS_AUTHORIZED=false
BSE_ACCESS_AUTHORIZED=false
NSE_FEED_URL=
BSE_FEED_URL=
# Optional exact lowercase hostnames (comma-separated) permitted for attachments.
NSE_ATTACHMENT_HOSTS=
BSE_ATTACHMENT_HOSTS=
# Optional authorized directory URL for BSE filename-only attachments.
BSE_ATTACHMENT_BASE_URL=

# Licensed provider URL, explicit permission, and optional credential.
LICENSED_FEED_URL=
LICENSED_ATTACHMENT_HOSTS=
LICENSED_FEED_AUTHORIZED=false
LICENSED_FEED_REQUIRES_TOKEN=false
LICENSED_FEED_TOKEN=

# Automatic live polling starts every 300 seconds and queues up to one new PDF per scan.
# The initial backfill horizon applies to manual and fixture discovery.
POLL_INTERVAL_SECONDS=300
POLL_OVERLAP_HOURS=48
INITIAL_BACKFILL_DAYS=180

# Source pacing, request timeouts, and resource limits.
SOURCE_MIN_GAP_MS=3000
SOURCE_TIMEOUT_MS=15000
DOWNLOAD_TIMEOUT_MS=30000
MAX_DOWNLOAD_BYTES=25000000
MAX_PDF_PAGES=150
MAX_SOURCE_PAGES=200
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_LLM_CALLS=1
MAX_JOB_ATTEMPTS=4
WORKER_LEASE_SECONDS=300

# Real-data profiles require Gemini and a key. The worker probes capability before sending transcript text.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_CHUNK_TARGET_TOKENS=6000
AI_CHUNK_OVERLAP_TOKENS=300
MAX_AI_INPUT_TOKENS_PER_DOC=160000
AI_TEMPERATURE=0

# Optional OCR flag and local synthetic demo replay gate.
ENABLE_OCR=false
ENABLE_DEMO_REPLAY=true

# JSON log severity and WebSocket resource limits.
LOG_LEVEL=info
WS_MAX_CLIENTS=100
WS_MAX_BUFFERED_BYTES=1048576
